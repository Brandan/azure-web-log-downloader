{
  "Azure": {
    "WebLogs": {
      "ConnectionString": "",
      "BlobContainerUrls": [
        "https://exampleaccount.blob.core.windows.net/weblogs",
        "https://exampleaccount.blob.core.windows.net/weblogs-archive"
      ],
      "PathPrefixes": [
        "BF-PROD-APP-1-UC/",
        "BF-PROD-APP-1-UC__1314/"
      ],
      "BlobPathTemplates": [
        "{instance}/{yyyy}/{MM}/{dd}/{HH}/{filename}.log",
        "w3c/{instance}/{yyyy}/{MM}/{dd}/{HH}/{filename}.log",
        "{yyyy}/{MM}/{dd}/{HH}/{instance}/{filename}.log"
      ],
      "SaveAllBlobsDirectory": "./logs",
      "DefaultDailyLookbackDays": 1,
      "DefaultWeeklyLookbackDays": 7,
      "EnableFileLogging": false,
      "FileLogPath": "./logs/azure-web-log-downloader.log"
    }
  }
}
